generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Estudiante {
  id        BigInt  @id @default(autoincrement())
  documento String?
  nombre    String?
  ciudad    String?
}

model Carrera {
  idcarrera BigInt  @id @default(autoincrement())
  nombre    String?
  area      String?
}

model Universidad {
  iduniversidad BigInt  @id @default(autoincrement())
  nombre        String?
  ciudad        String?
}

model Interes {
  id           BigInt    @id @default(autoincrement())
  idestudiante BigInt?
  idcarrera    BigInt?
  fechaInteres DateTime? @db.Date
}

model InteresUniversidad {
  id            BigInt  @id @default(autoincrement())
  idestudiante  BigInt?
  iduniversidad BigInt?
}

model UniversidadCarrera {
  iduniversidad BigInt?
  idcarrera     BigInt?
  id            BigInt  @id @default(autoincrement())
}
